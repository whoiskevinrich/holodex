# Holodex configuration (ADR-014)
# Precedence: CLI flags > environment variables > this file > built-in defaults.
# Every key here has an equivalent environment variable (shown in comments).
# Copy to holodex.yaml (or mount at $DATA_PATH/config/holodex.yaml) and edit.
#
# Local dev: a `.env` in the working directory is loaded into the environment at
# startup (ADR-027), so you can set MEDIA_PATH / HOST / etc. there instead of
# exporting vars — e.g. `MEDIA_PATH=E:/Media`. Real env vars and CLI flags still
# win. The same MEDIA_PATH also feeds the docker-compose media bind-mount.

# --- Paths ---
media_path: ""              # MEDIA_PATH   (required for scanning; read-only library root)
data_path: "./data"        # DATA_PATH    (read-write: db, thumbnails, config, etc.)
# database_path: ""        # DATABASE_PATH (defaults to ${data_path}/holodex.db)

# --- Server ---
# host: ""                  # HOST   bind address; empty = all interfaces (Docker default).
                            #        Set 127.0.0.1 to listen loopback-only (e.g. local dev:
                            #        avoids the Windows Firewall "allow access" prompt).
port: 7800                  # PORT
log_level: "info"          # LOG_LEVEL    (debug|info|warn|error)
# admin_token: ""           # ADMIN_TOKEN  gates the owner-only /admin surface (F21.7,
                            #              ADR-030). Empty = open (single-user default).
                            #              SET THIS whenever the server is reachable beyond
                            #              loopback; clients then send it as the
                            #              X-Admin-Token header. The server warns at startup
                            #              if it binds non-loopback with no token set.

# --- Scanner (ADR-011, ADR-018) ---
scan_interval_seconds: 300  # SCAN_INTERVAL_SECONDS
scan_workers: 4             # SCAN_WORKERS
follow_symlinks: true       # FOLLOW_SYMLINKS
scan_max_depth: 64          # SCAN_MAX_DEPTH
scan_min_age_seconds: 5     # SCAN_MIN_AGE_SECONDS (skip files modified more recently — mid-copy guard)

# --- Soft-delete + purge (F24, ADR-037) ---
# An owner delete is a soft-delete: the item hides immediately but its row and file
# survive the grace period, restorable from Trash. The purge sweep then hard-deletes
# expired items (and, by default, removes the file from disk).
delete_grace_period_seconds: 604800  # DELETE_GRACE_PERIOD_SECONDS (7 days; 0 disables auto-purge — Trash holds until you purge manually)
delete_remove_files: true            # DELETE_REMOVE_FILES (true = purge unlinks the file; false = DB-only, for read-only/externally-managed libraries)
purge_interval_seconds: 3600         # PURGE_INTERVAL_SECONDS (how often the grace-period purge sweep runs)

# --- Cache (ADR-008) ---
cache_backend: "memory"    # CACHE_BACKEND (memory|redis|none)
cache_max_memory_mb: 128    # CACHE_MAX_MEMORY_MB
# redis_url: ""            # REDIS_URL (required when cache_backend=redis)

# --- MCP server (Phase 2, ADR-005) ---
mcp_enabled: false          # MCP_ENABLED
mcp_transport: "http"      # MCP_TRANSPORT (http|stdio|both)
mcp_port: 7801              # MCP_PORT

# --- Thumbnails (Phase 2, ADR-009) ---
thumbnail_enabled: true     # THUMBNAIL_ENABLED
thumbnail_backfill: "eager" # THUMBNAIL_BACKFILL (eager|lazy)
thumbnail_workers: 2        # THUMBNAIL_WORKERS
thumbnail_nice: true        # THUMBNAIL_NICE
thumbnail_seek_percent: 10  # THUMBNAIL_SEEK_PERCENT
thumbnail_width: 400        # THUMBNAIL_WIDTH

# --- Metadata mapping (Phase 2, ADR-013) ---
# Surface extra container tags under custom labels. The mappings live in a
# separate file (copy metadata-mappings.yaml.example -> metadata-mappings.yaml);
# this is the path to it. A missing file simply means no configurable fields.
metadata_mappings_path: "./metadata-mappings.yaml"   # METADATA_MAPPINGS_PATH

# --- Metadata source plugins (Phase 3, F22, ADR-033) ---
# Sidecar providers (IMDB/TMDB, …) that enrich People (v1) with external data.
# Declared in a separate file (copy metadata-sources.yaml.example ->
# metadata-sources.yaml); a missing file means no providers. Enrichment is
# owner-gated and on-demand; core holds no upstream API keys (each provider does).
metadata_sources_path: "./metadata-sources.yaml"     # METADATA_SOURCES_PATH
