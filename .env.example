# Holodex — Docker Compose environment (copy to .env; .env is gitignored).
#
# Compose substitutes this into the read-only media bind-mount in docker-compose.yml.
# Use an absolute host path to your video library. On Docker Desktop (WSL2) use the
# WSL form, e.g. /mnt/c/Users/you/Videos. Defaults to ./media if unset.
HOLODEX_MEDIA_PATH=/path/to/your/videos
