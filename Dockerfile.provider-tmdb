# syntax=docker/dockerfile:1
# TMDB metadata provider sidecar (providers/tmdb/, ADR-033/039/040).
# Implements the Holodex provider HTTP contract: /healthz /describe /resolve /enrich.
# Required env: TMDB_API_TOKEN or TMDB_API_KEY.

FROM golang:1.27-bookworm AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -o /out/holodex-provider-tmdb ./providers/tmdb

# Runtime: distroless (ADR-105 D2). The binary is CGO_ENABLED=0 static, so the only thing it
# ever needed from userspace is a CA bundle for outbound TLS to TMDB — which this base ships.
# `debug` keeps a busybox shell for `docker exec` (no security boundary here: anyone who can
# exec already holds the Docker socket); `-nonroot` runs as uid 65532. Port 9100 is > 1024, so
# binding needs no capability. The same base ships to edge and latest — under ADR-070 a release
# retags this exact digest, so they cannot differ (ADR-105 D3).
FROM gcr.io/distroless/static-debian12:debug-nonroot
COPY --from=build /out/holodex-provider-tmdb /usr/local/bin/holodex-provider-tmdb
EXPOSE 9100
# Absolute paths, not a bare name: there is no shell here to fall back on if PATH ever shifts.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
    CMD ["/usr/local/bin/holodex-provider-tmdb", "-healthcheck"]
ENTRYPOINT ["/usr/local/bin/holodex-provider-tmdb"]
