# Go
/holodex
/holodex.exe
/tmdb.exe
/providers/tmdb/tmdb
/providers/tmdb/tmdb.exe
*.test
*.out

# Data / runtime
/data/
*.db
*.db-wal
*.db-shm

# graphify knowledge-graph output (generated; rebuild with /graphify)
/graphify-out/

# Frontend
/web/node_modules/
/web/dist/
/web/.svelte-kit/

# Test fixtures (generated; keep generator + goldens)
/testdata/mp4/
/testdata/mkv/

# Demo showcase corpus (generated media + node deps; keep the generator)
/testdata/demo/node_modules/
/testdata/demo/library/
/testdata/demo/.posters/

# Local config / overrides
/holodex.yaml
/metadata-mappings.yaml
/metadata-sources.yaml
/metadata-patterns.yaml
# Local per-profile config variants (live in the main worktree; each worktree's
# .claude/launch.json references them by absolute METADATA_*_PATH).
/metadata-mappings.local.*
/metadata-sources.local.*
/metadata-patterns.local.*
/docker-compose.override.yml

# Secrets / personal — never commit
.env
.env.*
!.env.example
.claude/settings.local.json
# Local dev-server config (machine-specific media paths; may hold provider tokens).
# Glob covers backups/variants (e.g. launch.json.bak) so a stray copy is never staged.
.claude/launch.json*

# Backup left by `graphify claude install` before it edits settings.json.
.claude/settings.json.graphify-bak

# Personal productivity workspace — not committed.
# (Project governance lives in .claude/CLAUDE.md; personal memory lives in ~/.claude.)
/TASKS.md
/dashboard.html
/CLAUDE.md
/memory/

# Browser-automation scratch (Playwright MCP snapshots/console logs)
.playwright-mcp/

# Editor / OS
.DS_Store
.idea/
.vscode/
