# Holodex configurable metadata field mapping (F20/F27, ADR-013).
#
# Copy to metadata-mappings.yaml (next to holodex.yaml, or set
# METADATA_MAPPINGS_PATH) to surface container tags and enrichment values under
# your own labels. All raw tags are captured at index time, so adding or changing a
# mapping needs no re-scan — POST /api/v1/admin/reload-config (or restart).
# Use the "Metadata keys" view (/keys) to discover which raw source keys your
# files actually carry.
#
# Each field maps one or more namespaced sources to a single canonical field:
#   canonical   stable id used in the API, as a query-param, and in the registry
#   label       display label on the detail page (defaults to the registry label)
#   sources     ordered source list. Namespace syntax (F27):
#                 file:title           videos.title column (scanner's primary title)
#                 file:<Key>           raw file tag from extra_metadata (case-insensitive)
#                 <provider>:<field>   enrichment shadow field, e.g. tmdb:title, or
#                                      filename:title (F48, parsed via a configured
#                                      filename_patterns rule)
#                 <Key>                legacy bare key treated as file:<Key>
#               How `sources` order is read depends on `default_source` (F36, ADR-051):
#                 default_source: file (DEFAULT) — the FILE/baseline value wins any
#                   undecided REPLACE field; providers are *candidates* the owner
#                   adopts per-field via the source control. `sources` order is then
#                   only the candidate suggestion order, NOT a display winner. List
#                   file sources first anyway for clarity.
#                 default_source: mapping — legacy precedence: first non-empty wins.
#               MERGE fields (multi/merge) union every source regardless of order and
#               are unaffected by decisions — order only sets first-seen display casing.
#   browse      when true, the resolved value overwrites video.Title in browse lists
#               (honoring any per-item source decision) so cards reflect the resolved
#               source instead of the raw filename
#   filterable  when true, becomes a browse facet + a ?<canonical>= query param
#   multi       when true, splits/aggregates multi-valued tags (e.g. genres)
#
# This example is a fully-wired reference for the tmdb provider: every field its
# /enrich response can produce — across all three entity types it supports (video,
# person, studio) — is mapped below. Comment out or delete anything you don't want
# to adopt; each entry is independent.

fields:
  # ============================ Video / film fields ============================

  # --- Title (file baseline; adopt a provider per-item via the source control) ---
  # Uncomment when a tmdb provider is configured in metadata-sources.yaml, and/or a
  # filename_patterns rule is configured (F48). Under the default (default_source:
  # file) the raw filename-stem fallback (file:title) shows until you adopt a
  # candidate for an item; set default_source: mapping for provider-first display.
  # - canonical: title
  #   browse: true
  #   sources:
  #     - file:title        # baseline: the scanner's raw filename-stem fallback
  #     - filename:title    # candidate: parsed via a configured filename pattern (F48)
  #     - tmdb:title        # candidate: adopt per-item, or wins under default_source: mapping

  - canonical: original_title
    sources:
      - tmdb:original_title

  # Listing a provider's key here also CLAIMS it (F49, ADR-074): the key becomes a
  # candidate of this field and stops auto-registering as its own display-only row.
  # That is how you collapse several providers' names for one thing into one row —
  # uncomment the extra sources below if your providers spell "overview" differently.
  # Claiming is provider-scoped (provA:synopsis does not touch provB:synopsis), and a
  # bare key is a file tag, so it claims nothing. See docs/reference/canonical-fields.md
  # ("Claiming a provider key") for the claim / promote / do-nothing decision table.
  - canonical: overview
    sources:
      - tmdb:overview
    # - provA:synopsis    # claimed → folds into Overview instead of its own row
    # - provB:comments    # claimed → same
    # - Comment           # bare = file tag (file:Comment); claims nothing

  - canonical: tagline
    sources:
      - tmdb:tagline

  - canonical: release_date
    sources:
      - filename:release_date   # candidate: parsed year from a filename pattern (F48)
      - tmdb:release_date

  - canonical: runtime
    sources:
      - tmdb:runtime

  # Resolved genres also auto-materialize into real Tag rows the moment a video is
  # enriched (deny-list filtered, hierarchy-aware, feeds genre writeback) — see
  # "Genre tag materialization & governance" in docs/reference/canonical-fields.md.
  # No extra config needed: any provider you add to sources below feeds the Tag
  # system for free.
  - canonical: genres
    multi: true
    filterable: true
    sources:
      - tmdb:genres

  - canonical: status
    sources:
      - tmdb:status

  - canonical: original_language
    sources:
      - tmdb:original_language

  - canonical: homepage
    sources:
      - tmdb:homepage

  - canonical: external_provider_id
    sources:
      - tmdb:external_provider_id

  # --- Poster → file cover art (MKV attachment / MP4 CoverArt / mp3+flac Picture) ---
  # When written back, Holodex downloads the URL and embeds the image as cover art.
  - canonical: poster_url
    label: Poster
    sources:
      - tmdb:poster_url

  # --- Cast & crew (MERGE fields: union of file tags + enrichment, order-agnostic) ---
  # Lists every file tag the scanner's peopleKeys classifies as a person (F40, ADR-072
  # RD9/P0-5) so the owner-authored/resolved-field derivation of video_people never
  # drops a link raw extraction used to catch. Producer is deliberately NOT listed
  # here (it stays unclaimed in peopleKeys, ADR-072 Consequences) — it's excluded
  # from derivation until it gets its own role, rather than silently mislabeled actor.
  - canonical: actors
    label: Actors
    sources:
      - Artist          # file tag
      - AlbumArtist      # file tag (music-video-style container tagging)
      - Cast             # file tag
      - Actor            # file tag
      - Actors           # file tag
      - Performer        # file tag
      - tmdb:actors     # top-10 billed cast from TMDB credits (joins the union)
      - filename:people # parsed {people} token from a filename pattern (F48; joins the union)
    multi: true

  - canonical: director
    label: Director
    sources:
      - Director        # file tag
      - tmdb:director   # from TMDB credits (job == Director; joins the union)
    filterable: true
    multi: true

  # --- Studio (REPLACE field: file baseline wins undecided; adopt tmdb per-item) ---
  - canonical: studio
    label: Studio
    sources:
      - Publisher       # file tags first — the baseline under default_source: file
      - Label
      - Studio
      - ProductionCompany
      - filename:studio # candidate: parsed from a filename pattern (F48)
      - tmdb:studio     # candidate: production companies from TMDB
    filterable: true

  - canonical: collection
    label: Film
    sources: [Album, Collection] # opinionated default (Album first) — remap to any file tag(s) your files use
    filterable: true

  # --- Series / episode ordering (file tags) ---
  # Matroska records these as localizable SimpleTags; Holodex strips the language
  # suffix at index time (SeasonNumber-und -> SeasonNumber), so one mapping matches
  # MKV and MP4 alike. Uncomment to surface them on the detail page.
  # - canonical: season
  #   label: Season
  #   sources: [SeasonNumber]
  #   filterable: true
  # - canonical: episode
  #   label: Episode
  #   sources: [EpisodeSort, PartNumber, EpisodeNumber]

  # ============================ Person entity fields ============================

  - canonical: bio
    sources:
      - tmdb:bio

  - canonical: birthdate
    sources:
      - tmdb:birthdate

  - canonical: deathdate
    sources:
      - tmdb:deathdate

  - canonical: nationality
    sources:
      - tmdb:nationality

  - canonical: aliases
    multi: true
    sources:
      - tmdb:aliases

  # website is shared by the person and studio entities — tmdb emits it on both
  # enrich responses under the same canonical key (a person's TMDB page, or a
  # studio's official/TMDB page). One mapping entry covers both.
  - canonical: website
    sources:
      - tmdb:website

  # Note: a person's photo is delivered as an asset (headshot/gallery/banner), not
  # a field value — there is no tmdb:photo source to map here.

  # ============================ Studio entity fields (F38) ============================

  - canonical: description
    sources:
      - tmdb:description

  - canonical: country
    sources:
      - tmdb:country

  - canonical: logo
    sources:
      - tmdb:logo
