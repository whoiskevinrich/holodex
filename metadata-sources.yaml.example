# Holodex metadata source providers (F22, ADR-033).
#
# Copy to metadata-sources.yaml (next to holodex.yaml, or set METADATA_SOURCES_PATH)
# to enrich People with data the files don't carry (bios, birthdates, photos) from
# external sources. A missing file simply means no providers — enrichment is then
# unavailable and the "Enrich" button never appears. Editing this file takes effect
# on POST /api/v1/admin/reload-config (or a restart) — no re-scan needed.
#
# Each provider is a SIDECAR container speaking a small HTTP contract
# (/describe, /resolve, /enrich, /healthz). Core only ever dials a base_url listed
# here (the SSRF allowlist) and holds NO upstream API keys — each provider owns its
# own key in its own container env. Enrichment is owner-gated (ADMIN_TOKEN) and
# strictly on-demand: nothing is fetched without an explicit click.
#
# Each entry:
#   name          provider id (shown in the UI and on /status; lowercase)
#   base_url      where core reaches the sidecar (compose service name on the
#                 internal network, or host:port). THIS is the SSRF allowlist —
#                 core never follows a provider response to any other host.
#   entity_types  what the provider can enrich; supports [person], [video], [studio],
#                 and/or [film] (F56/ADR-086 — a film's own entity type, distinct from
#                 [video]; its poster is a downloaded asset, not a resolved field)
#   asset_hosts   extra CDN hostnames whose asset URLs core is allowed to fetch
#                 (ADR-039). The sidecar's own base_url host is always implicitly
#                 allowed. Any listed host requires https. Example: TMDB serves
#                 portraits from image.tmdb.org, a different host from its sidecar.
#                 This same allowlist gates a provider's brand_icon (ADR-059): a
#                 provider that advertises a brand icon in /describe must serve it
#                 from its base_url host or a host listed here, or core refuses it
#                 and the UI shows a monogram. (The TMDB sidecar bundles + self-serves
#                 its logo from its own base_url host by default — no asset_hosts entry
#                 needed; TMDB_BRAND_ICON_URL overrides it with a raster on an
#                 allowlisted host if you prefer a CDN copy.)
#   enabled       false keeps it configured-but-off; flip to true once the sidecar
#                 is running and reachable at base_url
#   search_pattern
#                 (video only, F54/ADR-080) override this provider's /resolve search
#                 query shape instead of sending the raw/sanitized title. Space-joined
#                 {name} (required) / {name?} (optional) tokens over
#                 studio|title|performers|year, e.g. "{studio?} {title?} {performers?}
#                 {year?}" — rendered from the video's already-resolved fields.
#                 A required token with no value drops that WHOLE pattern for this
#                 render (falls to the provider's own preferred_search_pattern, then
#                 default_search_pattern below, then the sanitized title) — it never
#                 renders with a gap. An unknown token name is dropped at reload with
#                 a logged warning; the provider stays enabled either way. Whether or
#                 not any pattern is configured, the plain title fallback is always
#                 sanitized (bracket/comma punctuation and 720p/1080p/4k-style
#                 resolution tokens stripped) — that part has no on/off switch.

sources:
  - name: tmdb
    base_url: http://holodex-tmdb:9100
    entity_types: [person, video, studio, film]
    asset_hosts: [image.tmdb.org]   # TMDB CDN host for portrait + studio-logo downloads
    enabled: false
    # search_pattern: "{studio?} {title?} {performers?} {year?}"

# default_search_pattern applies to any enabled, video-capable provider above that sets
# neither its own search_pattern nor advertises a preferred_search_pattern via /describe
# (F54/ADR-080). Same grammar as search_pattern. Optional; omit for no fleet-wide default.
# default_search_pattern: "{title?} {year?}"

  # --- Local manual-QA stub (no network/keys) ---
  # Run the bundled fake provider, then enable this entry:
  #   preview_start enrich-stub          (or: node testdata/enrich-stub/stub.js)
  # See testdata/enrich-stub/README.md.
  # - name: fake
  #   base_url: http://127.0.0.1:9100
  #   entity_types: [person]
  #   enabled: true
